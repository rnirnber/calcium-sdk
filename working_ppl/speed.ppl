CNT := 1;

render()
BEGIN
  LOCAL a = (CNT == 0);
  LOCAL i;
  LOCAL k;
  FOR i FROM 0 to 5 DO
    FOR k FROM 0 to 3 DO
      IF CNT == 1 THEN
        render1(i * 53, k * 53);
      END;
      IF CNT == 0 THEN
        render2(i * 53, k * 53);
      END;
    END;
  END;
  IF a == TRUE THEN
    CNT := 1;
  END;
  IF a <> TRUE THEN
    CNT := 0;
  END;
  FREEZE();
END;
EXPORT FOO()
BEGIN
  WHILE TRUE DO
    render();
    WAIT(0.25);
  END;
END;