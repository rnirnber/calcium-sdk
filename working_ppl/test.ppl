render()
BEGIN
  RECT_P(G0, 0, 0, 318, 212, RGB(255, 255, 255), RGB(255, 255, 255));
  render1(0, 0);
  LOCAL i;
  LOCAL k;
  FOR i FROM 0 TO 5 DO
    FOR k FROM 0 TO 3 DO
      BLIT_P(G0, i * 53, k * 53, (i * 53) + 52, (k * 53) + 52, G1, 0, 0, 52, 52);
    END;
  END;
  FREEZE();
END;
EXPORT FOO()
BEGIN
  render();
END;
